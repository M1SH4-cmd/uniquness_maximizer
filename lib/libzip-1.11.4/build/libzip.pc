prefix=C:/Program Files/libzip
exec_prefix=${prefix}
bindir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

zipcmp=${bindir}/zipcmp

Name: libzip
Description: library for handling zip archives
Version: 1.11.4
Libs:  -L${libdir} -lzip
Libs.private:  -ladvapi32 -lbcrypt -lzlib
Cflags: -I${includedir}
